<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives access to the system media session API (Windows.Media.Control). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <!-- WFAC010 targets WinForms apps; this is a WPF app, which takes its DPI mode from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>MondayNotch</AssemblyName>
    <RootNamespace>MondayNotch</RootNamespace>
    <Product>Monday Notch</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also used for the tray icon. -->
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screen brightness goes through WMI (WmiMonitorBrightness). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
