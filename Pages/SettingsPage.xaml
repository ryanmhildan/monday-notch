<UserControl x:Class="MondayNotch.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- One settings line: label on the left, control on the right. -->
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Segments" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="12,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource Segments}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="GeneralTabBtn" GroupName="Tabs" Style="{StaticResource SegmentButton}" Content="General"
                       IsChecked="True" Checked="Tab_Checked" />
          <RadioButton x:Name="AppearanceTabBtn" GroupName="Tabs" Style="{StaticResource SegmentButton}" Content="Appearance"
                       Checked="Tab_Checked" />
          <RadioButton x:Name="IdleTabBtn" GroupName="Tabs" Style="{StaticResource SegmentButton}" Content="Idle"
                       Checked="Tab_Checked" />
          <RadioButton x:Name="AdvancedTabBtn" GroupName="Tabs" Style="{StaticResource SegmentButton}" Content="Advanced"
                       Checked="Tab_Checked" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <Grid>

          <!-- General -->
          <StackPanel x:Name="GeneralTab">
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Start with Windows" />
              <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="StartupToggle_Click" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Startup greeting" />
              <CheckBox x:Name="GreetingToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="GreetingToggle_Click" />
            </Grid>
            <Grid x:Name="GreetingNameRow" Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Greeting name" />
              <Border Style="{StaticResource Segments}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="NameAutoBtn" GroupName="GreetingName" Style="{StaticResource SegmentButton}" Content="Auto"
                               Checked="GreetingName_Checked" />
                  <RadioButton x:Name="NameCustomBtn" GroupName="GreetingName" Style="{StaticResource SegmentButton}" Content="Custom"
                               Checked="GreetingName_Checked" />
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="CustomNameBox" Background="{DynamicResource InputBrush}" CornerRadius="10" Height="28" Margin="2,0,2,4">
              <Grid>
                <TextBox x:Name="GreetingNameBox" Style="{StaticResource PlainTextBox}" Margin="8,0" MaxLength="40"
                         TextChanged="GreetingNameBox_TextChanged" />
                <TextBlock x:Name="GreetingNamePlaceholder" Text="Your name" Margin="11,0,0,0" FontSize="12.5"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <Grid Style="{StaticResource Row}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="Auto-compact" />
                <TextBlock Style="{StaticResource Hint}" Text="Shrink to a thin line while a browser is active" />
              </StackPanel>
              <CheckBox x:Name="CompactToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="CompactToggle_Click" />
            </Grid>
          </StackPanel>

          <!-- Appearance -->
          <StackPanel x:Name="AppearanceTab" Visibility="Collapsed">
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Notch shape" />
              <Border Style="{StaticResource Segments}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="AnchoredBtn" GroupName="Shape" Style="{StaticResource SegmentButton}" Content="Anchored"
                               Checked="Shape_Checked" />
                  <RadioButton x:Name="FloatingBtn" GroupName="Shape" Style="{StaticResource SegmentButton}" Content="Floating"
                               Checked="Shape_Checked" />
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="DistanceRow" Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Distance from top" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Slider x:Name="DistanceSlider" Style="{StaticResource ThinSlider}" Width="130" Minimum="0" Maximum="40"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="DistanceSlider_ValueChanged" />
                <TextBlock x:Name="DistanceText" Width="40" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                           TextAlignment="Right" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Theme" />
              <Border Style="{StaticResource Segments}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="DarkBtn" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Dark"
                               Checked="Theme_Checked" />
                  <RadioButton x:Name="LightBtn" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Light"
                               Checked="Theme_Checked" />
                  <RadioButton x:Name="AutoThemeBtn" GroupName="Theme" Style="{StaticResource SegmentButton}" Content="Auto"
                               Checked="Theme_Checked" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- Idle -->
          <StackPanel x:Name="IdleTab" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Hint}" Text="Live preview" Margin="2,0,0,4" />
            <Border Background="{DynamicResource NotchBrush}" CornerRadius="0,0,14,14" Width="230" Height="34"
                    HorizontalAlignment="Center" Margin="0,0,0,6">
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PreviewLeft" Orientation="Horizontal" HorizontalAlignment="Left" />
                <StackPanel x:Name="PreviewCenter" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" />
                <StackPanel x:Name="PreviewRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" />
              </Grid>
            </Border>

            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Left" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76B;" Tag="Left:-1" Click="Cycle_Click" />
                <TextBlock x:Name="LeftName" Width="66" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76C;" Tag="Left:1" Click="Cycle_Click" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Margin="6,0,0,0" Content="&#xE8CB;"
                        ToolTip="Swap with center" Tag="LeftCenter" Click="Swap_Click" />
              </StackPanel>
            </Grid>
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76B;" Tag="Center:-1" Click="Cycle_Click" />
                <TextBlock x:Name="CenterName" Width="66" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76C;" Tag="Center:1" Click="Cycle_Click" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Margin="6,0,0,0" Content="&#xE8CB;"
                        ToolTip="Swap with right" Tag="CenterRight" Click="Swap_Click" />
              </StackPanel>
            </Grid>
            <Grid Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Label}" Text="Right" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76B;" Tag="Right:-1" Click="Cycle_Click" />
                <TextBlock x:Name="RightName" Width="66" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76C;" Tag="Right:1" Click="Cycle_Click" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Margin="6,0,0,0" Content="&#xE8CB;"
                        ToolTip="Swap with left" Tag="RightLeft" Click="Swap_Click" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,4,2,0"
                       Text="Playing music shows the album art on the left and a running timer replaces the right slot." />
          </StackPanel>

          <!-- Advanced -->
          <StackPanel x:Name="AdvancedTab" Visibility="Collapsed">
            <Grid Style="{StaticResource Row}" MinHeight="40">
              <StackPanel VerticalAlignment="Center" Margin="0,0,90,0">
                <TextBlock Style="{StaticResource Label}" Text="Software update" />
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" />
              </StackPanel>
              <Button x:Name="UpdateBtn" Style="{StaticResource PillButton}" Content="Check" HorizontalAlignment="Right" Click="Update_Click" />
            </Grid>
            <Grid Style="{StaticResource Row}" MinHeight="40">
              <StackPanel VerticalAlignment="Center" Margin="0,0,90,0">
                <TextBlock Style="{StaticResource Label}" Text="Clean temporary files" />
                <TextBlock x:Name="CleanStatus" Style="{StaticResource Hint}" Text="Files in %TEMP% older than a day" />
              </StackPanel>
              <Button x:Name="CleanBtn" Style="{StaticResource PillButton}" Content="Clean" HorizontalAlignment="Right" Click="Clean_Click" />
            </Grid>
            <Grid Style="{StaticResource Row}" MinHeight="40">
              <StackPanel VerticalAlignment="Center" Margin="0,0,90,0">
                <TextBlock Style="{StaticResource Label}" Text="Restart notch" />
                <TextBlock Style="{StaticResource Hint}" Text="Close and reopen Monday Notch" />
              </StackPanel>
              <Button Style="{StaticResource PillButton}" Content="Restart" HorizontalAlignment="Right" Click="RestartNotch_Click" />
            </Grid>
            <Grid Style="{StaticResource Row}" MinHeight="40">
              <StackPanel VerticalAlignment="Center" Margin="0,0,90,0">
                <TextBlock Style="{StaticResource Label}" Text="Reset all settings" />
                <TextBlock x:Name="ResetStatus" Style="{StaticResource Hint}" Text="Your to-dos and note are kept" />
              </StackPanel>
              <Button x:Name="ResetBtn" Style="{StaticResource PillButton}" Content="Reset" HorizontalAlignment="Right" Click="Reset_Click" />
            </Grid>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
